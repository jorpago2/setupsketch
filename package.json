{
  "name": "setupsketch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "pnpm build && node --experimental-strip-types --test tests/app.test.mjs tests/model.test.ts",
    "lint": "eslint . --ignore-pattern dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@carbon/react": "1.113.0",
    "@ibm/plex": "6.4.1",
    "@jorpago2/scientific-ui": "file:vendor\\jorpago2-scientific-ui-0.6.5.tgz",
    "@xyflow/react": "12.11.2",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "playwright": "^1.62.1",
    "sass": "1.102.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  },
  "type": "module"
}
